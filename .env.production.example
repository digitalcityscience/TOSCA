# One TOSCA installation: its addresses, ports and secrets.
#
#   make init      creates .env.production from this file and fills in random secrets
#
# Never commit .env.production. Lines marked [secret] are filled in by `make init`.
#
# Environment files are named .env.<mode> with the mode written out;
# .env.development.example is the template for a development checkout. Both
# templates define the same variables: add a new one to both.

COMPOSE_PROJECT_NAME=tosca

############################
# Addresses
############################
# The name or IP address people type in the browser to reach this machine.
#
# tosca.localhost works out of the box for one machine: browsers send any
# *.localhost name to the machine itself, and the backend containers reach it
# too (LOCAL_HOST_ALIAS below). Plain "localhost" does NOT work, because inside
# a container it means the container. For other people to reach the
# installation, use the machine's LAN address or DNS name instead.
PUBLIC_HOST=tosca.localhost
# Only if PUBLIC_HOST is another *.localhost name: set the same name here.
#LOCAL_HOST_ALIAS=tosca.localhost

# Interface the published ports listen on. 0.0.0.0 = all interfaces.
BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_PORT=8000
GEOSERVER_PORT=8585
STORAGE_PORT=3900
# PostgreSQL is published on 127.0.0.1 only.
DB_PORT=5432

# The public addresses of the four browser-facing services. The defaults are
# plain http on the ports above. Behind a reverse proxy with TLS, replace them
# with the https addresses the proxy serves.
TOSCA_WEB_URL=http://${PUBLIC_HOST}:${WEB_PORT}
TOSCA_API_URL=http://${PUBLIC_HOST}:${API_PORT}
TOSCA_GEOSERVER_URL=http://${PUBLIC_HOST}:${GEOSERVER_PORT}/geoserver
TOSCA_STORAGE_URL=http://${PUBLIC_HOST}:${STORAGE_PORT}

# Host names the API answers to (no scheme, no port), comma-separated.
DJANGO_ALLOWED_HOSTS=${PUBLIC_HOST},localhost
# Origins allowed to call the API and to read media: the web app's address.
DJANGO_CORS_ALLOWED_ORIGINS=${TOSCA_WEB_URL}
GEOSERVER_CORS_ALLOWED_ORIGINS=${TOSCA_WEB_URL},${TOSCA_GEOSERVER_URL}
# Host names GeoServer accepts form posts from (no scheme, no port).
GEOSERVER_CSRF_WHITELIST=${PUBLIC_HOST}

############################
# Web app (all public: sent to the browser)
############################
APP_BRAND_NAME=TOSCA
MAP_START_LNG=10.0
MAP_START_LAT=53.55
MAP_START_ZOOM=11
# Required. Free key from https://www.maptiler.com/
MAPTILER_API_KEY=
# Comma-separated; empty enables the default set.
ENABLED_FEATURES=

############################
# Sign-in (Keycloak)
############################
# Required today. The backend refuses to start without KEYCLOAK_ISSUER,
# KEYCLOAK_JWKS_URL and KEYCLOAK_CLIENT_ID (system checks tosca.settings.E004-
# E006); see docs/roadmap/authentication.md. Point the first block at an
# existing Keycloak realm. The WEB_KEYCLOAK_* block is the web app's public
# client; leave all three empty and the web app shows no sign-in.
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
ALLOWED_TOKEN_AUDIENCES=
ALLOWED_TOKEN_CLIENTS=
WEB_KEYCLOAK_URL=
WEB_KEYCLOAK_REALM=
WEB_KEYCLOAK_CLIENT_ID=

############################
# Database
############################
PG_DATABASE=tosca
PG_SUPERUSER=postgres
PG_API_USER=tosca_api
PG_GS_USER=tosca_gs
PG_SUPERPASS=            # [secret]
PG_API_PASSWORD=         # [secret]
PG_GS_PASSWORD=          # [secret]

############################
# GeoServer
############################
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=   # [secret]

############################
# Backend
############################
DJANGO_SECRET_KEY=       # [secret]
FIELD_ENCRYPTION_KEY=    # [secret]

############################
# Object storage (Garage)
############################
S3_ACCESS_KEY_ID=        # [secret]
S3_SECRET_ACCESS_KEY=    # [secret]
GARAGE_RPC_SECRET=       # [secret]
GARAGE_ADMIN_TOKEN=      # [secret]
