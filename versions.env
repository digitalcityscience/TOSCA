# The TOSCA platform release: the exact images that were tested together.
#
# Every image is pinned as name:tag@sha256:digest. The tag is for people, the
# digest is what Docker pulls. A platform release is a tag of this repository;
# this file at that tag is the release.
#
# No component release has been published to GHCR yet, so the three TOSCA
# images below carry no digest. Until they do, `make build-local` builds them
# from source and writes versions.local.env, which overrides this file.

TOSCA_VERSION=unreleased

BACKEND_IMAGE=ghcr.io/digitalcityscience/tosca-backend:unreleased
FRONTEND_IMAGE=ghcr.io/digitalcityscience/tosca-frontend:unreleased
GEOSERVER_IMAGE=ghcr.io/digitalcityscience/tosca-geoserver:unreleased

# Upstream images, used unchanged.
POSTGIS_IMAGE=postgis/postgis:16-3.4@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
GARAGE_IMAGE=dxflrs/garage:v2.3.0@sha256:866bd13ed2038ba7e7190e840482bc27234c4afaf77be8cfa439ae088c1e4690
CURL_IMAGE=curlimages/curl:8.11.1@sha256:c1fe1679c34d9784c1b0d1e5f62ac0a79fca01fb6377cdd33e90473c6f9f9a69
