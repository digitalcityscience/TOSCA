# The TOSCA platform release: the exact images that were tested together.
#
# Every image is pinned as name:tag@sha256:digest. The tag is for people, the
# digest is what Docker pulls. A platform release is a tag of this repository;
# this file at that tag is the release.
#
# `make build-local` builds the images from source instead and writes
# versions.local.env, which then overrides this file.

TOSCA_VERSION=2026.11.1

BACKEND_IMAGE=ghcr.io/digitalcityscience/tosca-backend:1.0.0@sha256:5d276f82465b4ed708f4ac069151918f3b309a20e5003807319ee177542eda9d
FRONTEND_IMAGE=ghcr.io/digitalcityscience/tosca-frontend:1.0.0@sha256:284ca3cf94021a33a08c916b55c324e74fc51786015edf66af52cab903c7bcbc
GEOSERVER_IMAGE=ghcr.io/digitalcityscience/tosca-geoserver:2.28.5-tosca.1@sha256:24509cd9c4108cef6967a13d1297a92b9c3f3d840b48203ec4c2cb80a01c3729

# Upstream images, used unchanged.
POSTGIS_IMAGE=postgis/postgis:16-3.4@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
GARAGE_IMAGE=dxflrs/garage:v2.3.0@sha256:866bd13ed2038ba7e7190e840482bc27234c4afaf77be8cfa439ae088c1e4690
